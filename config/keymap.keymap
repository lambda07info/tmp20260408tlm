#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <8>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };
    };

    behaviors {
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };

        hmtl: hmtl {
            compatible = "zmk,behavior-hold-tap";
            label = "HMTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 45 46 47 48 49 50 51 59 60 61 62 63 64 65>;
            hold-trigger-on-release;
        };

        hmtr: hmtr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40 41 42 43 44 52 53 54 55 56 57 58>;
            hold-trigger-on-release;
        };

        hlt: hlt {
            compatible = "zmk,behavior-hold-tap";
            label = "HLT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <280>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_win {
            bindings = <
&kp ESC    &kp N1           &kp N2     &kp N3  &kp N4  &kp N5                           &kp N6   &kp N7  &kp N8     &kp N9    &kp N0       &kp BSPC
&kp TAB    &kp Q            &kp W      &kp E   &kp R   &kp T                            &kp Y    &kp U   &kp I      &kp O     &kp P        &kp BSPC
&kp LCTRL  &kp A            &kp S      &kp D   &kp F   &kp G      &mkp LCLK  &mkp RCLK  &kp H    &kp J   &kp K      &kp L     &hlt 5 SEMI  &kp SQT
&kp LSHFT  &kp Z            &kp X      &kp C   &kp V   &kp B      &kp SPACE  &kp RET    &kp N    &kp M   &kp COMMA  &kp DOT   &kp FSLH     &kp RSHFT
&kp LCTRL  &lt_thumb 4 TAB  &kp LCTRL  &mo 5   &mo 3   &kp SPACE  &mo 2      &kp BSPC   &kp RET  &trans  &trans     &kp RGUI  &kp K_APP    &kp RCTRL
            >;
        };

        base_mac {
            bindings = <
&trans  &trans  &trans    &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LGUI  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sym {
            bindings = <
&trans  &trans     &trans     &trans     &trans      &trans                     &trans     &trans    &trans     &trans    &trans    &trans
&trans  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR  &kp PRCNT                  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &kp EQUAL  &kp MINUS  &kp GRAVE  &kp LANG2   &kp LANG1  &trans  &trans  &trans     &kp SQT   &kp LBKT   &kp RBKT  &kp PIPE  &trans
&trans  &kp PLUS   &kp UNDER  &kp TILDE  &trans      &trans     &trans  &trans  &trans     &kp DQT   &kp LBRC   &kp RBRC  &kp BSLH  &trans
&trans  &trans     &trans     &trans     &trans      &trans     &trans  &trans  &kp LSHFT  &trans    &trans     &trans    &trans    &trans
            >;
        };

        modnav {
            bindings = <
&trans  &trans     &trans     &trans     &trans   &trans                    &trans     &trans     &trans     &trans     &trans   &trans
&trans  &kp ESC    &sk LSHFT  &sk LSHFT  &mo 4    &kp INS                   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp DEL  &trans
&trans  &sk LCTRL  &sk LGUI   &sk LALT   &kp TAB  &kp RALT  &trans  &trans  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp RET  &trans
&trans  &kp F1     &kp F2     &kp F3     &kp F4   &kp F5    &trans  &trans  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10  &trans
&trans  &mo 7      &trans     &trans     &trans   &trans    &trans  &trans  &kp LSHFT  &trans     &trans     &trans     &trans   &trans
            >;
        };

        num {
            bindings = <
&trans  &trans    &trans     &trans     &trans     &trans                     &trans     &trans  &trans  &trans  &trans  &trans
&trans  &kp A     &kp A      &kp A      &kp A      &kp A                      &trans     &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &kp PLUS  &kp MINUS  &kp FSLH   &kp ASTRK  &kp EQUAL  &trans  &trans  &kp COMMA  &kp N4  &kp N5  &kp N6  &kp N0  &trans
&trans  &kp LBKT  &kp LPAR   &kp COLON  &kp RPAR   &kp RBKT   &trans  &trans  &kp DOT    &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans    &trans     &trans     &trans     &tog 4     &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &mo 6   &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mo 6   &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &mo 6   &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        fnbt {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans  &trans        &trans        &trans        &trans          &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &trans  &out OUT_USB  &out OUT_BLE  &sys_reset    &bt BT_CLR      &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &to 0         &to 1         &trans        &trans          &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans          &trans
            >;
        };

        sym1 {
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans                      &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &trans      &kp GRAVE   &kp MINUS   &kp EQUAL   &trans      &trans  &trans  &kp PIPE    &kp SQT     &kp LBKT    &kp RBKT    &trans      &trans
&trans  &trans      &kp TILDE   &kp UNDER   &kp PLUS    &trans      &trans  &trans  &kp BSLH    &kp DQT     &kp LBRC    &kp RBRC    &trans      &trans
&trans  &trans      &trans      &trans      &trans      &trans      &trans  &trans  &kp TAB     &kp DEL     &trans      &trans      &trans      &trans
            >;
        };

        navnum1 {
            bindings = <
&trans  &trans     &trans     &trans     &trans       &trans                   &trans     &trans    &trans    &trans     &trans  &trans
&trans  &kp N1     &kp N2     &kp N3     &kp N4       &kp N5                   &kp N6     &kp N7    &kp N8    &kp N9     &kp N0  &trans
&trans  &kp LCTRL  &kp ASTRK  &kp EQUAL  &kp LS(TAB)  &kp TAB  &trans  &trans  &kp PG_UP  &kp LEFT  &kp UP    &kp RIGHT  &trans  &trans
&trans  &kp LSHFT  &kp PLUS   &kp MINUS  &kp A        &kp ESC  &trans  &trans  &kp PG_DN  &kp HOME  &kp DOWN  &kp END    &trans  &trans
&trans  &trans     &trans     &trans     &trans       &trans   &trans  &trans  &trans     &trans    &trans    &trans     &trans  &trans
            >;
        };

        navnav2 {
            bindings = <
&trans  &trans    &trans     &trans     &trans      &trans                     &trans     &trans  &trans  &trans   &trans     &trans
&trans  &kp A     &kp PG_UP  &kp UP     &kp PG_DN   &kp A                      &kp FSLH   &kp N7  &kp N8  &kp N9   &kp MINUS  &trans
&trans  &kp HOME  &kp LEFT   &kp DOWN   &kp RIGHT   &kp END    &trans  &trans  &kp ASTRK  &kp N4  &kp N5  &kp N6   &kp PLUS   &trans
&trans  &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT   &kp RSHFT  &trans  &trans  &kp N0     &kp N1  &kp N2  &kp N3   &kp EQUAL  &trans
&trans  &trans    &trans     &trans     &kp DELETE  &kp TAB    &trans  &trans  &trans     &trans  &trans  &kp DOT  &trans     &trans
            >;
        };
    };
};
